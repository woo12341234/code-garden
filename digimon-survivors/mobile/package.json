{
  "name": "yokai-survivors-android",
  "version": "1.0.0",
  "private": true,
  "description": "Android wrapper (Capacitor) for 요괴 퇴치록",
  "scripts": {
    "web": "node copy-web.js",
    "android:add": "npm run web && npx cap add android && node android-setup.js",
    "android:sync": "npm run web && npx cap sync android && node android-setup.js",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0"
  }
}
